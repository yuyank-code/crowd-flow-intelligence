# Local development defaults; do not put secrets here.
DATABASE_URL=sqlite+aiosqlite:///./crowd_flow.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
SIMULATION_HZ=2.0
MAX_AGENTS=20000

# Used by docker compose (required there). Generate with: openssl rand -hex 24
OPERATOR_API_KEY=
