APP_NAME=Crowd Flow Intelligence
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite+aiosqlite:///./crowd_flow.db

SIMULATION_HZ=2.0
MAX_AGENTS=20000
SNAPSHOT_INTERVAL_SEC=5.0
HISTORY_RETENTION_ROWS=5000

# Geospatial (public OSM services; set a real contact in the user agent)
GEO_USER_AGENT=CrowdFlowIntelligence/0.1 (you@example.com)

# CCTV: only sources you are authorized to access, e.g.
# CCTV_SOURCES_JSON=[{"id":"cam-1","name":"Gate E","kind":"http-json","zone":"gate-e","url":"https://example.com/cam"}]
CCTV_SOURCES_JSON=[]

# Security
# Operator key for state-changing endpoints (send as X-API-Key). Empty = auth OFF (local dev only).
# Generate one with: openssl rand -hex 24
OPERATOR_API_KEY=
# Trust X-Forwarded-For for rate limiting. Only enable behind your own reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_OPERATOR=60
RATE_LIMIT_GEO=20
RATE_LIMIT_PARSE=30
WS_MAX_CONNECTIONS=200
WS_MAX_PER_IP=10
