APP_NAME=Crowd Flow Intelligence
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite+aiosqlite:///./crowd_flow.db

SIMULATION_HZ=2.0
MAX_AGENTS=20000
SNAPSHOT_INTERVAL_SEC=5.0
HISTORY_RETENTION_ROWS=5000

# Geospatial (public OSM services; set a real contact in the user agent)
GEO_USER_AGENT=CrowdFlowIntelligence/0.1 (you@example.com)

# CCTV: only sources you are authorized to access, e.g.
# CCTV_SOURCES_JSON=[{"id":"cam-1","name":"Gate E","kind":"http-json","zone":"gate-e","url":"https://example.com/cam"}]
CCTV_SOURCES_JSON=[]

# Security
# Operator key for state-changing endpoints (send as X-API-Key). Empty = auth OFF (local dev only).
# Generate one with: openssl rand -hex 24
OPERATOR_API_KEY=
# Trust X-Forwarded-For for rate limiting. Only enable behind your own reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_OPERATOR=60
RATE_LIMIT_GEO=20
RATE_LIMIT_PARSE=30
WS_MAX_CONNECTIONS=200
WS_MAX_PER_IP=10

# --- Camera management ---------------------------------------------------
# Camera mutating/control routes return 503 until OPERATOR_API_KEY (above) is set. Send it as X-API-Key.
# Fernet key for stored camera credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CCTV_SECRET_KEY=
# Optional: restrict cameras to these hosts / IPs / CIDRs (JSON list). Empty = any non-blocked address.
CCTV_ALLOWED_HOSTS=[]
CCTV_MAX_SESSIONS=4
# Media gateway that serves browser-playable HLS (e.g. MediaMTX) and the key used to sign short-lived playback tokens.
# Backend -> gateway address (inside Docker: http://mediamtx:8888). Browser address below (e.g. http://localhost:8888).
MEDIA_GATEWAY_BASE_URL=
MEDIA_GATEWAY_PUBLIC_URL=
PLAYBACK_SIGNING_KEY=
PLAYBACK_TOKEN_TTL_SEC=60

# Laptop webcam mode only: credentials ffmpeg must use to send video into the gateway (empty = publishing denied).
GATEWAY_PUBLISH_USER=
GATEWAY_PUBLISH_PASSWORD=
